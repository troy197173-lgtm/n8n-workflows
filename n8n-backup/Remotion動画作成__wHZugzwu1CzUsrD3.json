      "name": "HTTP Request1",
      "credentials": {
        "googleApi": {
          "id": "rKIeWR82vBV5zQbG",
          "name": "Google Service Account account 2"
        },
        "httpHeaderAuth": {
          "id": "K1Qcrxjl29WjOvIx",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Gemini TTS のレスポンス JSON\nconst res = $input.item.json;\n\n// Base64 の PCM を取り出す\nconst base64String =\n  res?.candidates?.[0]?.content?.parts?.[0]?.inlineData?.data;\n\nif (!base64String) {\n  throw new Error(\n    'Gemini TTS の Base64 音声データが見つかりません。\\nレスポンス: ' +\n    JSON.stringify(res, null, 2)\n  );\n}\n\n// Base64 → PCMバイト列\nconst pcmData = Buffer.from(base64String, 'base64');\n\n// ---- ここから WAV のヘッダーを付ける処理 ----\nconst numChannels = 1;\nconst sampleRate = 24000;\nconst bitsPerSample = 16;\n\nconst byteRate = sampleRate * numChannels * (bitsPerSample / 8);\nconst blockAlign = numChannels * (bitsPerSample / 8);\nconst subchunk2Size = pcmData.length;\nconst chunkSize = 36 + subchunk2Size;\n\nconst header = Buffer.alloc(44);\n\n// RIFFヘッダー\nheader.write('RIFF', 0);                    // ChunkID\nheader.writeUInt32LE(chunkSize, 4);         // ChunkSize\nheader.write('WAVE', 8);                    // Format\n\n// fmt チャンク\nheader.write('fmt ', 12);                   // Subchunk1ID\nheader.writeUInt32LE(16, 16);               // Subchunk1Size (PCM)\nheader.writeUInt16LE(1, 20);                // AudioFormat (1 = PCM)\nheader.writeUInt16LE(numChannels, 22);      // NumChannels\nheader.writeUInt32LE(sampleRate, 24);       // SampleRate\nheader.writeUInt32LE(byteRate, 28);         // ByteRate\nheader.writeUInt16LE(blockAlign, 32);       // BlockAlign\nheader.writeUInt16LE(bitsPerSample, 34);    // BitsPerSample\n\n// data チャンク\nheader.write('data', 36);                   // Subchunk2ID\nheader.writeUInt32LE(subchunk2Size, 40);    // Subchunk2Size\n\n// ヘッダー + PCM本体 で WAV データ完成\nconst wavBuffer = Buffer.concat([header, pcmData]);\n\n// n8n に返す\nreturn {\n  binary: {\n    data: {\n      data: wavBuffer,\n      mimeType: 'audio/wav',\n      fileName: 'voice.wav'\n    }\n  },\n  json: res\n};\n\n"
      },
