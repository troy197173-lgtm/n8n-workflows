    {
      "parameters": {
        "jsCode": "const GENKO_NODE = \"Get row(s) in sheet\";\nconst data = $node[GENKO_NODE].json;\n\nconst fullText = data[\"音声原稿\"] || \"\";\nconst filename = data[\"Filename\"] || \"voice\";\n\n// 「。」で分割して6つのアイテムを作成\nconst sentences = fullText.split(/(?<=。)/).filter(s => s.trim() !== \"\");\n\nreturn sentences.map((sentence, index) => {\n  return {\n    json: {\n      \"音声原稿\": sentence.trim(),\n      \"Filename\": filename,\n      \"index\": index\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -48
      ],
      "id": "610569b6-68df-4e8b-949e-255344751d3e",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "// 1. 辞書ノードの名前\nconst JISHO_NODE = \"Get row(s) in sheet1\";\n\n// 2. 「今届いたアイテムすべて」をループで処理する\n// これにより、入力された6つのアイテムそれぞれに対して処理を行い、6つ出力します\nreturn $input.all().map((item) => {\n  let script = item.json[\"音声原稿\"] || \"\";\n  let filename = item.json[\"Filename\"] || \"voice\";\n  let index = item.json[\"index\"] || 0;\n\n  // 辞書データを取得して置換\n  let dictionaryItems = [];\n  try {\n    dictionaryItems = $(JISHO_NODE).all();\n  } catch (e) {}\n\n  if (script !== \"\" && dictionaryItems.length > 0) {\n    for (const d of dictionaryItems) {\n      const word = d.json.Word;\n      const reading = d.json.Reading;\n      if (word && reading) {\n        const regex = new RegExp(word.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&'), 'g');\n        script = script.replace(regex, reading);\n      }\n    }\n  }\n\n  // SSML作成\n  const ssmlText = `<speak><prosody rate=\"1.0\" pitch=\"0st\" volume=\"0dB\">${script}</prosody></speak>`;\n\n  // 処理したアイテムを返す\n  return {\n    json: {\n      \"音声原稿\": script,\n      \"Filename\": filename,\n      \"index\": index,\n      \"ssmlText\": ssmlText\n    }\n  };\n});"
      },
