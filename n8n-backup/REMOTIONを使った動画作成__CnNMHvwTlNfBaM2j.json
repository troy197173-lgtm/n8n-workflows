      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1) シート側の情報を保持したまま使う\nconst rowJson = { ...$json };      // ← ここに番号/rowIndex/picture name等がいる\nconst responseData = $json.gen ?? $json;    // ← HTTP Requestで \"Put response in field\" にした場合\n\n// 2) 画像データ抽出\nlet base64String = null;\n\nif (responseData?.candidates?.length) {\n  const parts = responseData.candidates[0]?.content?.parts ?? [];\n  for (const part of parts) {\n    if (part.inlineData?.data) {\n      base64String = part.inlineData.data;\n      break;\n    }\n  }\n}\nif (!base64String) throw new Error(\"画像データが見つかりません。\");\n\n// 3) バイナリ化\nconst binaryData = Buffer.from(base64String, \"base64\");\n\n// 4) ファイル名はシートの picture name を使う（個別になる）\nconst picName =\n  rowJson.picture_name ??\n  rowJson[\"picture name\"] ??\n  rowJson.pictureName ??\n  \"generated_image\";\n\n// gen はもう不要なら消す（重くなるので）\ndelete rowJson.gen;\n\nreturn {\n  json: {\n    ...rowJson,          // ← 番号が残る！\n    picture_name: picName,\n    message: \"画像変換成功\",\n  },\n  binary: {\n    data: {\n      data: binaryData.toString(\"base64\"),\n      mimeType: \"image/png\",\n      fileName: picName.endsWith(\".png\") ? picName : `${picName}.png`,\n    },\n  },\n};\n"
      },
