      "parameters": {
        "jsCode": "// 画像アップロードノードと音声アップロードノードから全アイテムを取得\nconst pictureItems = $items(\"Upload file\", 0);\nconst voiceItems   = $items(\"Upload file1\", 0);\n\n// ★シート行（音声テキスト）も取得\nconst sheetItems   = $items(\"Get row(s) in sheet\", 0);\n\nif (pictureItems.length !== voiceItems.length) {\n  throw new Error(`画像(${pictureItems.length})と音声(${voiceItems.length})の数が違います`);\n}\nif (sheetItems.length !== pictureItems.length) {\n  throw new Error(`シート(${sheetItems.length})と画像(${pictureItems.length})の数が違います（並び順/行数を確認）`);\n}\n\n// slides 配列を組み立てる（★text付き）\nconst slides = [];\n\nfor (let i = 0; i < pictureItems.length; i++) {\n  const picId   = pictureItems[i].json.id;\n  const audioId = voiceItems[i].json.id;\n\n  const text = (sheetItems[i].json[\"音声\"] ?? \"\").toString();\n\n  slides.push({\n    imageUrl: `https://drive.google.com/uc?export=download&id=${picId}`,\n    audioUrl: `https://drive.google.com/uc?export=download&id=${audioId}`,\n    text, // ★追加\n  });\n}\n\n// ★avatarをこのノードで確実に作る（ここが重要：$json.avatar に依存しない）\nconst avatarEnabled = true; // ←必要に応じて false に\n\nconst avatar = {\n  enabled: avatarEnabled,\n  videoUrl: \"https://drive.google.com/uc?export=download&id=19Y1AMNyzZfBy4dofbjO9jfGnHZumHj43\",\n  // stillUrl は送っても送らなくてもOK（webhook側で連番1枚目を使うなら不要）\n  position: { right: -390, bottom: 20 },\n};\n\nreturn [\n  {\n    json: {\n      slides,\n      avatar,\n    },\n  },\n];\n"
      },
