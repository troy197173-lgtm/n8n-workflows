    {
      "parameters": {
        "jsCode": "// --- inputs ---\nconst rows  = $items(\"Get row(s) in sheet\", 0);   // シート行\nconst files = $items(\"List Pictures\", 0);         // フォルダ内のファイル一覧\n\n// 正規化（大小/全角スペース差/余計な空白を吸収）\nconst norm = (s) =>\n  (s ?? \"\")\n    .toString()\n    .trim()\n    .replace(/\\s+/g, \" \")\n    .toLowerCase();\n\n// 画像だけ残して name->id の辞書を作る\nconst map = new Map();\nfor (const f of files) {\n  const id = f.json.id;\n  const name = f.json.name;\n  if (!id || !name) continue;\n\n  const lower = name.toLowerCase();\n  const isImage =\n    lower.endsWith(\".png\") ||\n    lower.endsWith(\".jpg\") ||\n    lower.endsWith(\".jpeg\") ||\n    lower.endsWith(\".webp\");\n\n  if (!isImage) continue;\n\n  const key = norm(name);\n  if (!map.has(key)) map.set(key, id);\n}\n\n// シート行ごとに一致判定してフラグ付け\nreturn rows.map((r, idx) => {\n  const picName = (r.json[\"picture name\"] ?? \"\").toString();\n  const hitId = map.get(norm(picName));\n\n  return {\n    json: {\n      ...r.json,\n      rowIndex: idx,                   // 後で並び順を保証\n      picture_name: picName,\n      picture_key: norm(picName),  \n      picture_id: hitId ?? null,       // あれば既存IDが入る\n      needsGenerateImage: !hitId,      // 無ければ生成\n    },\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
